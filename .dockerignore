# Secrets must never enter the image. Without this, `COPY . .` in the
# Dockerfile bakes .env and .secret_key into the published layer.
.env
.env.*
!.env.example
.secret_key
*.pem
*.key

# VCS and tooling
.git
.gitignore
.github
.pytest_cache
.mypy_cache
**/__pycache__
**/*.py[cod]
.venv
venv
.vscode
.idea

# Dependencies (reinstalled in the image)
node_modules

# Local data -- never ship a database or backups into an image
*.db
*.sqlite3
backups
logs
instance
uploads
tests

# Docs and agent config
docs
*.md
!README.md
.kilo
AGENTS.md
