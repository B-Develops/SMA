# Flask secret key for sessions
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# PostgreSQL connection (the only supported database)
# Format: postgresql://username:password@host:5432/database_name
# On Windows, if the password contains special characters (e.g. @ or /) it must
# be percent-encoded:  @ -> %40   / -> %2F   : -> %3A
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sarkinmota

# Connection pool tuning. pool_size is per gunicorn worker, so keep
# (workers * pool_size) well under PostgreSQL's default max_connections of 100.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000

# Email Configuration (SMTP)
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@sarkinmotaautos.com

# Application URL (used in email links)
BASE_URL=https://yourdomain.com

# Redis URL for caching and background tasks (optional)
REDIS_URL=redis://localhost:6379/0

# Session Security
SESSION_COOKIE_SECURE=True
SESSION_TIMEOUT_MINUTES=30

# Production Security
FORCE_HTTPS=True
HSTS=True

# Test user creation (only for init_db.py)
CREATE_TEST_USER=False
